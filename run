#!/usr/bin/env bash
set -euo pipefail
app_dir=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)

if [[ -f "$app_dir/build/qml/Nexus/Mpv/libnexusmpvplugin.so" ]]; then
  qml_root="$app_dir/build/qml"
  shell_path="$app_dir/qml/shell.qml"
elif [[ -f "$app_dir/qml/Nexus/Mpv/libnexusmpvplugin.so" ]]; then
  qml_root="$app_dir/qml"
  shell_path="$app_dir/shell.qml"
else
  cmake -S "$app_dir" -B "$app_dir/build" -DCMAKE_BUILD_TYPE=Release
  cmake --build "$app_dir/build" --parallel
  qml_root="$app_dir/build/qml"
  shell_path="$app_dir/qml/shell.qml"
fi

source_arg="${1:-}"
if [[ -n "$source_arg" && "$source_arg" != *://* ]]; then
  source_arg="$(realpath -m -- "$source_arg")"
fi
export NEXUS_SOURCE="$source_arg"
export QML_IMPORT_PATH="$qml_root${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
export QSG_RHI_BACKEND=opengl
# Keep the mpv framebuffer on Quickshell's GUI render loop. This avoids a
# driver-specific crash in libmpv's OpenGL context setup on some hybrid GPU
# Wayland sessions when Quickshell uses its threaded scene graph.
export QSG_RENDER_LOOP=basic
# libmpv requires the numeric locale to be exactly C during initialization.
export LC_NUMERIC=C
exec quickshell --path "$shell_path"
